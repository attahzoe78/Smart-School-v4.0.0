{
  "appId": "com.sisitech.smartschool",
  "productName": "Smart School",
  "copyright": "Copyright © 2024 Sisi Technology Ltd",

  "directories": {
    "output": "dist",
    "buildResources": "electron/assets"
  },

  "files": [
    "electron/**/*",
    "public/**/*",
    "prisma/schema.prisma",
    "node_modules/.prisma/**/*",
    "node_modules/@prisma/client/**/*",
    "node_modules/prisma/**/*",
    "scripts/setup.js",
    "scripts/postbuild.js",
    "package.json"
  ],

  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "app/.next/standalone"
    },
    {
      "from": "public",
      "to": "app/public"
    },
    {
      "from": "prisma",
      "to": "app/prisma"
    },
    {
      "from": "scripts",
      "to": "app/scripts"
    }
  ],

  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "SmartSchool-Setup-${version}.${ext}"
  },

  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Smart School",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "license": "LICENSE.txt"
  },

  "publish": {
    "provider": "github",
    "owner": "attahzoe78",
    "repo": "Smart-School-v4.0.0",
    "releaseType": "release"
  }
}
